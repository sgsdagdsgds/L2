// 1 2kybsum
function hasTwoCubeSums(n) {
  let count = 0;

  for (let a = 1; a * a * a < n; a++) {
    for (let b = a + 1; a * a * a + b * b * b <= n; b++) {
      if (a * a * a + b * b * b === n) {
        count++;
      }
    }
  }

  return count >= 2;
}


// 2 What century is it?
function whatCentury(year) {
  let y = Number(year);
  let century = Math.ceil(y / 100);
  let ending = "th";

  if (century % 100 < 11 || century % 100 > 13) {
    let lastDigit = century % 10;

    if (lastDigit === 1) {
      ending = "st";
    } else if (lastDigit === 2) {
      ending = "nd";
    } else if (lastDigit === 3) {
      ending = "rd";
    }
  }

  return century + ending;
}


// 3 Find the missing term in an arithmetic progression
function findMissing(list) {
  let firstDiff = list[1] - list[0];
  let lastDiff = list[list.length - 1] - list[list.length - 2];
  let step = Math.abs(firstDiff) < Math.abs(lastDiff) ? firstDiff : lastDiff;

  for (let i = 0; i < list.length - 1; i++) {
    if (list[i + 1] - list[i] !== step) {
      return list[i] + step;
    }
  }
}


// 4 Primes in numbers
function primeFactors(n) {
  let result = "";

  for (let d = 2; d * d <= n; d++) {
    let power = 0;

    while (n % d === 0) {
      n /= d;
      power++;
    }

    if (power > 0) {
      result += power === 1 ? `(${d})` : `(${d}**${power})`;
    }
  }

  if (n > 1) result += `(${n})`;

  return result;
}


// 5 WeIrD StRiNg CaSe
function toWeirdCase(string) {
  let words = string.split(" ");
  let result = [];

  for (let w = 0; w < words.length; w++) {
    let word = words[w];
    let newWord = "";

    for (let i = 0; i < word.length; i++) {
      if (i % 2 === 0) {
        newWord += word[i].toUpperCase();
      } else {
        newWord += word[i].toLowerCase();
      }
    }

    result.push(newWord);
  }

  return result.join(" ");
}


// 6 Mexican Wave
function wave(str) {
  let result = [];

  for (let i = 0; i < str.length; i++) {
    if (str[i] === " ") {
      continue;
    }

    let newStr = str.slice(0, i) + str[i].toUpperCase() + str.slice(i + 1);
    result.push(newStr);
  }

  return result;
}


// 7 Write number in expanded form
function expandedForm(num) {
  let str = String(num);
  let parts = [];

  for (let i = 0; i < str.length; i++) {
    if (str[i] !== "0") {
      let zeros = str.length - i - 1;
      parts.push(str[i] + "0".repeat(zeros));
    }
  }

  return parts.join(" + ");
}


// 8 Split strings
function solution(str) {
  if (str.length % 2 !== 0) {
    str = str + "_";
  }

  let result = [];

  for (let i = 0; i < str.length; i += 2) {
    result.push(str[i] + str[i + 1]);
  }

  return result;
}


// 9 Lottery ticket
function bingo(ticket, win) {
  let miniWins = 0;

  for (let i = 0; i < ticket.length; i++) {
    let text = ticket[i][0];
    let number = ticket[i][1];

    for (let j = 0; j < text.length; j++) {
      if (text.charCodeAt(j) === number) {
        miniWins++;
        break;
      }
    }
  }

  if (miniWins >= win) {
    return "Winner!";
  } else {
    return "Loser!";
  }
}


// 10 Extract the domain name from a URL
function domainName(url) {
  if (url.startsWith("https://")) {
    url = url.slice(8);
  } else if (url.startsWith("http://")) {
    url = url.slice(7);
  }

  if (url.startsWith("www.")) {
    url = url.slice(4);
  }

  return url.split(".")[0];
}


// 11 Convert a hex string to RGB
function hexStringToRGB(hexString) {
  let red = hexString.slice(1, 3);
  let green = hexString.slice(3, 5);
  let blue = hexString.slice(5, 7);

  return {
    r: parseInt(red, 16),
    g: parseInt(green, 16),
    b: parseInt(blue, 16)
  };
}


// 12 Circularly sorted array
function isCircleSorted(arr) {
  let drops = 0;

  for (let i = 0; i < arr.length; i++) {
    let current = arr[i];
    let next = arr[(i + 1) % arr.length];

    if (next < current) {
      drops++;
    }
  }

  return drops <= 1;
}




// 13 Extend the Array class
Array.prototype.square = function () {
  return this.map(x => x * x);
};

Array.prototype.cube = function () {
  return this.map(x => x * x * x);
};

Array.prototype.sum = function () {
  return this.reduce((total, x) => total + x, 0);
};

Array.prototype.average = function () {
  return this.sum() / this.length;
};

Array.prototype.even = function () {
  return this.filter(x => x % 2 === 0);
};

Array.prototype.odd = function () {
  return this.filter(x => x % 2 !== 0);
};


// 14 Cache function results
function cache(func) {
  let memory = {};

  return function () {
    let key = JSON.stringify(Array.from(arguments));

    if (key in memory) {
      return memory[key];
    }

    let result = func.apply(this, arguments);
    memory[key] = result;
    return result;
  };
}


// 15 Create phone number
function createPhoneNumber(numbers) {
  let digits = numbers.join("");

  let first = digits.slice(0, 3);
  let second = digits.slice(3, 6);
  let third = digits.slice(6);

  return "(" + first + ") " + second + "-" + third;
}
